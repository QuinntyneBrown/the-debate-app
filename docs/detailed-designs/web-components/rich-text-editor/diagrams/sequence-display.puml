@startuml
title UML sequence behaviour — Display content
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Parent component" #D1FADF
  participant "MeetingEditComponent" as parent
end box
box "Frontend — projects/components" #E0F2FE
  participant "RichTextEditorComponent" as rte
  participant "RichTextEngine" as lib
end box
parent -> rte : value = HTML string
rte -> lib : setHtml(value)
lib --> rte : Content rendered in content element

@enduml
