@startuml
title UML sequence behaviour — Drop files
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Club administrator" as actor
box "Frontend — projects/components" #E0F2FE
  participant "FileDropZoneComponent" as zone
end box
box "Frontend — Parent component" #D1FADF
  participant "Parent" as parent
end box
actor -> zone : Drop files
zone -> zone : preventDefault
zone -> zone : Create FormData
loop each dropped file
  zone -> zone : append(file.name, file) (L2-029 criterion 3)
end
zone -> parent : filesDropped(FormData)

@enduml
