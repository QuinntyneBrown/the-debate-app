@startuml
title UML sequence behaviour — Active class follows the route
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Angular framework" #D1FADF
  participant "Router" as router
end box
box "Frontend — projects/components" #E0F2FE
  participant "LinkComponent" as link
  participant "Host element" as host
end box
router -> link : NavigationEnd event (url)
link -> link : Compare url path with link path
alt current route path equals link path (L2-020 criterion 4)
  link -> host : add class active
else paths differ
  link -> host : remove class active
end

@enduml
