@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Tab strip component

Container_Boundary(spa, "Web client (projects/components, projects/the-debate-app and feature libraries)") {
  Component(edit, "MeetingEditComponent", "Angular standalone component (projects/meetings)", "Projects tabs and panels")
  Component(strip, "TabStripComponent", "Angular standalone component", "Selection, ARIA state, keyboard and focus")
