@startuml
title UML sequence behaviour — Select a tab by click
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — projects/components" #E0F2FE
  participant "TabStripComponent" as strip
end box
actor -> strip : Click tab i
strip -> strip : select(i)
strip -> strip : Set tabindex, aria-selected, aria-hidden for all tabs and panels (L2-028 criterion 3)
strip -> strip : Set host selected attribute to i
strip -> strip : Focus tab i (L2-028 criterion 4)
strip --> actor : selectedIndexChange(i)

@enduml
