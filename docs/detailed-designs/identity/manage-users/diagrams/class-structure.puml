@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Manage users

class UserDto {
  +id: number | null
  +name: string
}
class User {
  +id: number
  +name: string
  +username: string | null
  +password: string | null
  +email: string | null
  +isDeleted: boolean
}
class UserService {
  +addOrUpdate(dto: UserDto): Promise<UserDto>
  +get(): Promise<UserDto[]>
  +getById(id: number): Promise<UserDto | null>
  +remove(id: number): Promise<number>
}
class UserRepository {
  +findForUpdate(id: number): Promise<User | null>
  +insert(user: User): Promise<User>
  +update(user: User): Promise<void>
}
class SoftDeletableRepository<User>
SoftDeletableRepository <|-- UserRepository
UserService ..> UserDto : accepts and returns
UserService --> UserRepository : uses
UserRepository --> User : persists
@enduml
